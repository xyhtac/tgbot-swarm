// Build openvpn microservice with parameters

pipeline {

    agent any

    parameters {
        choice(name: 'DEPLOY', choices: ['dev', 'prod'], description: 'Select deployment environment')
    }

    environment {

        SERVICE                 = 'controller'                              // Microservice identifier
        REGISTRY_CREDENTIALS    = 'registry-creds'                          // Registry Credentials identifier in Jenkins store
        CONTAINER_REGISTRY      = credentials('container-registry-url')     // Container Registry to put docker image

    }
    

    stages {
                
        stage('Configure pipeline') {
            steps {
                script {
                    if (env.DEPLOY != 'dev' && env.DEPLOY != 'prod') {
                        echo 'Parameter not set, using default'
                        env.DEPLOY = 'dev'
                    }
                    env.CONFIGURATION = "pipeline/infrastructure-${DEPLOY}.conf"
                }
                load "${CONFIGURATION}"

                // Get secrets from jenkins storage: API key, Swarm hostname and SSH password for user jenkins
                env.API_KEY                 = credentials("${PROJECT}-apikey")      // Swarm API Key from Jenkins secrets store
                env.HOSTNAME                = credentials("${PROJECT}-hostname")    // Swarm node hostname from Jenkins secrets store
            }
        }


        stage('Checkout Repo') {
            steps {
                script {
                    git(
                        url: "https://github.com/xyhtac/tgbot-swarm",
                        branch: "${DEPLOY}",
                        changelog: true,
                        poll: true
                    )
                    sh 'ls -la'
                }
            }
        }

        stage('Set Version') {
            steps {
                script {
                    // Get version from Git tag or commit SHA
                    env.VERSION = sh(script: "git describe --tags --always", returnStdout: true).trim()
                    echo "Version set to ${env.VERSION}"
                }
            }
        }


        stage('Generate SSL Keys') {
            steps {
                env.CERT_NAME = "${PROJECT}-${SERVICE}"
                // regenerate SSL Certificate and keys on every deploy.
                sh "cd swarm && openssl req -newkey rsa:2048 -sha256 -nodes -keyout ${CERT_NAME}.key -x509 -days 3650 -out ${CERT_NAME}.pem -subj '/C=US/ST=New York/L=Brooklyn/O=${PROJECT} /CN=${HOSTNAME}'"
                sh 'cd swarm && ls -la'
            }
        }



        stage("Generate controller config") {
            steps {
                writeFile(
                    file: "swarm/config/local-${DEPLOY}.json",
                    text: """\
                        {
                            "controller": {
		                        "host": "${API_IP}",
		                        "port": "${API_PORT}"
	                        },
                            "proxy":{
                                "host": "${PROXY_IP}",
		                        "port": "${PROXY_PORT}",
                                "fqdn": "${HOSTNAME}"
                            },
                            "defaults": {
                                "verbose": ${VERBOSE},
                                "portrange": [ 3002, 4000 ],
                                "proxycmd": "/usr/sbin/nginx -s reload",
                                "payloads": "config/payloads.json",
                                "nginxconfig": "/etc/nginx/endpoints.conf",
                                "certificate": "${CERT_NAME}.pem",
                                "sslkey": "${CERT_NAME}.key"
                            },
                            "api": {
                                "key": "${API_KEY}"
                            }
                        }
                    """.stripIndent()
                )
            }
        }

        stage("Generate proxy configs") {
            steps {
                writeFile(
                    file: "swarm/proxy/conf/nginx.conf",
                    text: """\
                        events {
                            # configuration of connection processing
                        }
                        http {
                            # Configuration specific to HTTP and affecting all virtual servers
                            
                            # enable reverse proxy
                            proxy_redirect              off;
                            proxy_socket_keepalive      on;
                            proxy_send_timeout          10s;
                            proxy_set_header            X-Real-IP   \$remote_addr;
                            proxy_set_header            X-Forwarded-For \$proxy_add_x_forwarded_for;
                            proxy_set_header            X-Forwarded-Host \$server_name;
                            proxy_set_header            X-Forwarded-Proto https;

                            server {
                                listen ${PROXY_PORT} ssl;
                                server_name ${HOSTNAME};

	                            # ssl_session_cache   shared:SSL:10m;
                                ssl_session_timeout 1d;
                                
                                ssl_verify_client   off;
                                ssl_protocols               TLSv1.2 TLSv1.3;
                                ssl_ciphers                 ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES128-GCM-SHA256;
                                ssl_prefer_server_ciphers   on;
                                
                                ssl_certificate     /etc/nginx/${CERT_NAME}.pem;
                                ssl_certificate_key /etc/nginx/${CERT_NAME}.key;

                                # serve local files
                                location / {
                                    root /usr/share/nginx/html;
                                    index index.html;
                                }

                                # redirect controller microservice
                                location ${API_PATH}/ {
                                    rewrite ^${API_PATH}/(.*)\$ /\$1 break;
                                    proxy_pass http://${API_IP}:${API_PORT}/;
                                }

                                # link controller-generated configurations
                                include /etc/nginx/endpoints.conf;
                            }
                        }
                    """.stripIndent()
                )
                writeFile(
                    file: "swarm/proxy/conf/endpoints.conf",
                    text: """\
                        # placeholder endpoint config for startup
                    """.stripIndent()
                )
            }
        }

        stage("Generate Dockerfile") {
            steps {
                writeFile(
                    file: "swarm/Dockerfile",
                    text: """\
                        FROM nginx

                        # install node 14.19.1
                        RUN apt update
                        RUN apt install wget -y
                        RUN apt install xz-utils -y
                        RUN wget https://nodejs.org/download/release/v14.19.1/node-v14.19.1-linux-x64.tar.xz
                        RUN tar -xvf node-v14.19.1-linux-x64.tar.xz
                        RUN cp -r node-v14.19.1-linux-x64/bin /usr/
                        RUN cp -r node-v14.19.1-linux-x64/include /usr/
                        RUN cp -r node-v14.19.1-linux-x64/lib /usr/
                        RUN cp -r node-v14.19.1-linux-x64/share /usr/
                        RUN export PATH=/usr/node-v14.19.1-linux-x64/bin:\$PATH

                        # run node js server
                        WORKDIR /app
                        COPY ./package.json /app/package.json
                        COPY ./package-lock.json /app/package-lock.json
                        RUN npm install
                        COPY . .

                        #nginx conf  
                        RUN rm /etc/nginx/nginx.conf /etc/nginx/conf.d/default.conf
                        COPY proxy/conf /etc/nginx
                        COPY proxy/content /usr/share/nginx/html
                        COPY ${CERT_NAME}.key /etc/nginx/${CERT_NAME}.key
                        COPY ${CERT_NAME}.pem /etc/nginx/${CERT_NAME}.pem
                        EXPOSE ${PROXY_PORT}/tcp
                        
                        CMD nginx -g 'pid /var/run/nginx.pid;' & node /app/api-controller.js
                    """.stripIndent()
                )
            }
        }


        stage("Build and commit image") {

            steps {
                script {
                    def repo = "${PROJECT}-${SERVICE}-${DEPLOY}"
                    def artifact_file = "tags_${PROJECT}.txt"
                    def tmp_file = "${artifact_file}.tmp"

                    def baseTag = "${CONTAINER_REGISTRY}/${repo}:${VERSION}-build${BUILD_NUMBER}"
                    def baseLatestTag = "${CONTAINER_REGISTRY}/${repo}:latest"
                    
                    imageLatestTag = baseLatestTag
                    imageTag = baseTag
                    
                    // --- Build Image ---
                    sh "cd swarm && docker build -t ${imageTag} -t ${imageLatestTag} ."

                    withCredentials([usernamePassword(
                        credentialsId: "${REGISTRY_CREDENTIALS}",
                        usernameVariable: 'REG_USER',
                        passwordVariable: 'REG_PASS'
                    )]) {

                        // --- Push image ---
                        sh """
                            echo "$REG_PASS" | docker login ${CONTAINER_REGISTRY} -u "$REG_USER" --password-stdin
                            docker push ${imageTag}
                            docker push ${imageLatestTag}
                            docker logout ${CONTAINER_REGISTRY}
                        """

                        sh """
                            curl -s -u "$REG_USER:$REG_PASS" "https://${CONTAINER_REGISTRY}/v2/${repo}/tags/list" \
                                | jq -r '.tags // [] | .[]' \
                                | sed "s#^#${repo}:#" \
                                > "${tmp_file}"
                            
                            cat ${tmp_file}

                            if [ -f "${artifact_file}" ]; then
                                cat "${artifact_file}" >> "${tmp_file}"
                            fi

                            sort -u "${tmp_file}" > "${artifact_file}"
                            rm -f "${tmp_file}"
                            touch "${artifact_file}"
                        """
                    }

                    // Archive global list
                    archiveArtifacts artifacts: "${artifact_file}", allowEmptyArchive: false

                    // --- Cleanup ---
                    sh "docker rmi ${imageTag} || true"
                }
            }
        }
    }
}